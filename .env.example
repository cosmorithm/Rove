# 填入服务商提供的兼容 OpenAI 的基础地址和模型名称。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# 本地无鉴权服务可留空。
OPENAI_API_KEY=

# Coding mode uses DeepSeek Harness and its Messages-compatible endpoint.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# Leave empty to use the bundled DSH runtime's default model.
DEEPSEEK_MODEL=
