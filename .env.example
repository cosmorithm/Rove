# 可在应用的 AI 设置中选择厂商并保存，或直接编辑以下配置。
# 支持 deepseek、openai、anthropic、gemini、qwen、custom。
ROVE_AI_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# 本地无鉴权服务可留空。
OPENAI_API_KEY=

# Coding mode uses DeepSeek Harness and its Messages-compatible endpoint.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# Leave empty to use the bundled DSH runtime's default model.
DEEPSEEK_MODEL=
